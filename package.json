{
  "name": "austin-cultural-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "present": "vite --mode presenter --open",
    "build": "vite build",
    "check:public": "node scripts/check_public_bundle.mjs",
    "build:shapes": "node scripts/build_map_shapes.mjs",
    "build:places": "node scripts/build_place_names.mjs",
    "build:history": "node scripts/rebuild_census_history.mjs && node scripts/rebuild_acs_history.mjs",
    "build:areas": "node scripts/build_area_names.mjs",
    "build:latest": "node scripts/build_latest_acs.mjs",
    "build:stages": "node scripts/build_stages.mjs",
    "build:rail": "node scripts/build_light_rail.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "propagate": "node archive/data/propagateRegionIds.js"
  },
  "dependencies": {
    "@turf/turf": "^7.3.4",
    "d3": "^7.9.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
